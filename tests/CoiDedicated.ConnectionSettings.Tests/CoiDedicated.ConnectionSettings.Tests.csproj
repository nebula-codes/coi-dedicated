    <Reference Include="UnityEngine"><HintPath>$(GameDir)\Captain of Industry_Data\Managed\UnityEngine.dll</HintPath></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(GameDir)\Captain of Industry_Data\Managed\UnityEngine.CoreModule.dll</HintPath></Reference>
  </ItemGroup>
</Project>
