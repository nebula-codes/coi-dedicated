    <GameDir Condition="'$(GameDir)' == ''">F:\SteamLibrary\steamapps\common\Captain of Industry</GameDir>
    <BepInExDir>$(MSBuildThisFileDirectory)..\..\.work\dependencies\BepInEx_win_x64_5.4.23.5\BepInEx\core</BepInExDir>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\..\src\CoiDedicated.Client\ConnectionSettings.cs" Link="ConnectionSettings.cs" />
