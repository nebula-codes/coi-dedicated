<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GameDir Condition="'$(GameDir)' == ''">F:\SteamLibrary\steamapps\common\Captain of Industry</GameDir>
    <GameManagedDir>$(GameDir)\Captain of Industry_Data\Managed</GameManagedDir>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../CoiDedicated/NativeSteamSession.cs" Link="NativeSteamSession.cs" />
    <Reference Include="Mafi"><HintPath>$(GameManagedDir)\Mafi.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
</Project>
